# Syntrueno — copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # A2A_AUTH_SECRET

PROJECT_NAME="Syntrueno"
ENVIRONMENT="development"

# true  = offline heuristics, zero API calls, full test suite passes with no creds
# false = live Gemini / Firestore / Model Armor
SIMULATION_MODE=true

# --- Gemini ---------------------------------------------------------------
# Free key, no card: https://aistudio.google.com/apikey
# Verified 2026-08-22: gemini-2.5-* returns 404 for new keys; the Pro tier
# returns 429 on the free tier. Measured latency: flash-lite ~8.5s with
# thinking disabled, 3.6-flash ~25.4s with thinking enabled.
GEMINI_API_KEY=""
FAST_MODEL="gemini-3.5-flash"
REASONING_MODEL="gemini-3.6-flash"
FAST_THINKING_BUDGET=0
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# Which backend serves Gemini. The two are NOT interchangeable:
#   false -> AI Studio. Needs GEMINI_API_KEY. Free, but the thinking-capable
#            Flash models are capped at 20 requests/day EACH, which is why the
#            model chain below exists. Serves gemini-3.x; 404s gemini-2.5-*.
#   true  -> Vertex AI. Needs Application Default Credentials and a billing
#            account, no API key. No daily cap, and gemini-2.5-pro becomes
#            reachable. Serves both families -- but only from VERTEX_LOCATION.
USE_VERTEX_AI=false

# Vertex serves Gemini from here, and this is deliberately NOT
# GOOGLE_CLOUD_LOCATION. Verified by execution 2026-08-25: every gemini-3.x
# model returns 404 NOT_FOUND from us-central1 and resolves from "global".
# Setting this to your deployment region silently breaks the whole chain.
VERTEX_LOCATION="global"

# --- Google Cloud ---------------------------------------------------------
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
FIRESTORE_DATABASE="(default)"
FIRESTORE_ENABLED=false
# Local auth uses Application Default Credentials:
#   gcloud auth application-default login
# On Cloud Run the attached service account is used automatically.
GOOGLE_APPLICATION_CREDENTIALS=""

# --- Model Armor ----------------------------------------------------------
# MODEL_ARMOR_ENABLED turns the regex screening layer on.
# USE_REAL_MODEL_ARMOR additionally calls modelarmor.googleapis.com, which
# catches paraphrased injections no regex can enumerate (measured 2026-08-25:
# 4/8 novel injections caught vs 0/8 for regex alone). It needs billing and
# the template below to exist. When it is unreachable the regex verdict still
# stands and the scan reports degraded_reason rather than implying it is clean.
MODEL_ARMOR_ENABLED=true
USE_REAL_MODEL_ARMOR=false
MODEL_ARMOR_TEMPLATE_ID="syntrueno-enterprise-standard"
MODEL_ARMOR_LOCATION="us-central1"

# --- Gemma screening (third inbound layer) -------------------------------
# Served by the AI Studio API, not Vertex, so this needs GEMINI_API_KEY even
# when USE_VERTEX_AI is true. Measured 2026-08-25: caught 8/8 paraphrased
# injections that regex and Model Armor both miss, 0 false positives, and
# failed outright on 2 of 10 calls -- which is why it can never block an
# incident. The timeout bounds the worst case; on expiry the layer drops out
# and the scan says so.
USE_GEMMA_SCREEN=false
GEMMA_MODEL="gemma-4-26b-a4b-it"
GEMMA_TIMEOUT_SECONDS=3.0

# --- Event-driven ingestion ----------------------------------------------
# Cloud Monitoring alert -> Pub/Sub push -> POST /api/v1/ingest/pubsub.
# This is the only path that reaches the swarm with no human in the loop,
# so it stays off until you name the caller. The service is deployed
# --allow-unauthenticated for the console, which means Cloud Run will not
# check the caller for you -- the OIDC token is verified in the app.
#
# PUBSUB_PUSH_SERVICE_ACCOUNT has no default on purpose. Left empty, any
# Google-issued token would satisfy the check, so the code refuses instead
# of treating "unset" as "allow".
# PUBSUB_AUDIENCE must equal the push endpoint URL configured on the
# subscription, or every token fails audience validation.
PUBSUB_INGEST_ENABLED=false
PUBSUB_PUSH_SERVICE_ACCOUNT=""
PUBSUB_AUDIENCE=""

# --- Zero-trust A2A -------------------------------------------------------
# Generate your own. Do not ship a default.
A2A_AUTH_SECRET=""
A2A_TOKEN_TTL_SECONDS=120

# --- Remediation guardrails ----------------------------------------------
# The ONLY service the swarm may mutate. Enforced in app/cloud/runadmin.py.
CANARY_SERVICE_NAME="syntrueno-canary"
REMEDIATION_DRY_RUN=true

# --- Web ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

